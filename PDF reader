class PdfListItem extends StatelessWidget {
  final String fileName;
  final String date;
  final String size;
  final bool hasRedIcon;

  const PdfListItem({
    super.key,
    required this.fileName,
    required this.date,
    required this.size,
    required this.hasRedIcon,
  });

  @override
  Widget build(BuildContext context) {
    return ListTile(
      contentPadding: const EdgeInsets.symmetric(horizontal: 16, vertical: 4),
      leading: Container(
        width: 40,
        height: 50,
        decoration: BoxDecoration(
          border: hasRedIcon ? Border.all(color: Colors.red, width: 1.5) : null,
          borderRadius: BorderRadius.circular(4),
          color: hasRedIcon ? Colors.transparent : Colors.grey[200],
        ),
        child: hasRedIcon 
          ? const Center(child: Text('PDF', style: TextStyle(color: Colors.red, fontSize: 10, fontWeight: FontWeight.bold)))
          : const Icon(Icons.picture_as_pdf, color: Colors.grey),
      ),
      title: Text(
        fileName,
        maxLines: 2,
        overflow: TextOverflow.ellipsis,
        style: const TextStyle(fontSize: 15, fontWeight: FontWeight.w500),
      ),
      subtitle: Padding(
        padding: const EdgeInsets.only(top: 4.0),
        child: Row(
          children: [
            const Icon(Icons.phone_android, size: 14, color: Colors.grey),
            const SizedBox(width: 4),
            Text('PDF • $date • $size', style: const TextStyle(fontSize: 12, color: Colors.grey)),
          ],
        ),
      ),
      trailing: const Icon(Icons.more_vert, color: Colors.grey),
    );
  }
}

